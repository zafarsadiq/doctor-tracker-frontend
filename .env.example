# The browser calls this path on the same site; Next.js forwards it to the backend (see next.config.mjs)
NEXT_PUBLIC_API_URL=/api
# Where the Express API really lives. Server-side only, never sent to the browser. Needed at build time.
API_PROXY_TARGET=http://localhost:5000
# true = built-in demo data; false = use the Express API
NEXT_PUBLIC_USE_MOCK=true
